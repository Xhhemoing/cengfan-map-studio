{
  "name": "cengfan-map-studio",
  "version": "0.1.3",
  "private": true,
  "description": "Local-first graduation destination map editor with spreadsheet import and PNG/SVG export.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "homepage": "https://xhhemoing.github.io/cengfan-map-studio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xhhemoing/cengfan-map-studio.git"
  },
  "bugs": {
    "url": "https://github.com/Xhhemoing/cengfan-map-studio/issues"
  },
  "keywords": [
    "graduation",
    "map-editor",
    "local-first",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:ai": "tsx server/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "test": "node scripts/run-heavy.mjs vitest run",
    "test:watch": "vitest",
    "test:release": "node --test scripts/release-metadata.test.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "lint": "node scripts/run-heavy.mjs eslint .",
    "typecheck": "tsc -b --noEmit",
    "security:audit": "node scripts/run-heavy.mjs npm audit --registry=https://registry.npmjs.org",
    "perf:layout": "tsx scripts/perf-layout-bench.ts",
    "perf:canvas": "tsx scripts/perf-canvas-bench.ts",
    "data:sync:china-locations": "node scripts/sync-china-locations.mjs",
    "data:sync:china-universities": "node scripts/sync-china-universities.mjs",
    "preview": "npm run start",
    "check": "npm run test:release && npm run typecheck && npm run lint && npm test && npm run build",
    "data:sync:china-university-emblems": "node scripts/sync-china-university-emblems.mjs",
    "promo:check": "node scripts/宣发流程-素材检查.mjs",
    "promo:content": "node scripts/宣发流程-内容生成.mjs",
    "promo:report": "node scripts/宣发流程-数据收集.mjs --report"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.26.0",
    "pinyin-pro": "^3.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild": [
      "postinstall"
    ]
  }
}
