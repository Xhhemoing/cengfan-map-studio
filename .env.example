# AI 接口（OpenAI 兼容）配置
# 复制为 .env 并填写真实值。未配置时 AI 接口自动回退到本地规则（local-fallback）。
AI_API_KEY=
# 智能助手默认使用 deepseek-v4-flash；需要时可显式改为 gpt-5.6-luna。
AI_MODEL=deepseek-v4-flash
AI_BASE_URL=https://api.deepseek.com
AI_FALLBACK_MODEL=gpt-5.6-luna
# DeepSeek 官方 API key；也可复用 AI_API_KEY。
DEEPSEEK_API_KEY=
# 单次请求超时（毫秒）与最大输出 token。Agent 循环必须至少 4000。
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=4000

# 可选：工作区 API 访问 token、管理员密码（与 AI 无关）
# WORKSPACE_API_TOKEN=
# ADMIN_PASSWORD=
