# AI 接口（OpenAI 兼容）配置。未配置 agent key 时自动使用本地规则。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
# agent 主模型配置，未设置时回退到上面的兼容旧变量。
AI_PRIMARY_API_KEY=
AI_PRIMARY_BASE_URL=
AI_PRIMARY_MODEL=
# agent 备选模型；备选端点与模型完全相同则自动禁用。
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=gpt-5.6-luna
# DeepSeek 旧兼容密钥变量。
DEEPSEEK_API_KEY=
# 单次上游请求超时与 agent 单回合输出上限。
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=4000
# agent 任务限制与每个模型单回合重试策略。
AI_AGENT_MAX_ROUNDS=20
AI_AGENT_TOKEN_BUDGET=60000
AI_RETRY_MAX_ATTEMPTS=2
AI_RETRY_BASE_DELAY_MS=250
# agent 预算回执签名密钥；生产环境至少 32 个字符
AI_BUDGET_RECEIPT_SECRET=
# 生产环境 AI 访问策略：设置为 1 才允许无工作区 token 的公网 AI 请求
AI_PUBLIC_ACCESS=0
# 单实例 AI 运行时状态文件与停机等待上限
DATA_DIR=.data
AI_STATE_FILE=.data/ai-runtime-state.json
SHUTDOWN_TIMEOUT_MS=10000
# 仅在可信反向代理后设置为 1
TRUST_PROXY=0

# 静态演示站（Cloudflare Pages / GitHub Pages）。GitHub 项目站需要 BASE_PATH=/cengfan-map-studio/
# BASE_PATH=/
# VITE_PUBLIC_DEMO=1

# 可选:工作区 API 访问 token(与 AI 无关)
# WORKSPACE_API_TOKEN=
